# Skopiuj do .env (opcjonalne – aplikacja działa bez tego pliku)
PORT=8787
# Podsumowania pisane przez LLM. Bez klucza używany jest szablon.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Obraz Node dla Dockera. Przy limicie Docker Hub (429): mirror.gcr.io/library/node:22-alpine
NODE_IMAGE=node:22-alpine
# Open-Meteo przy limicie 429: klucz planu komercyjnego (https://open-meteo.com/en/pricing)
OPEN_METEO_API_KEY=
# ...albo własna instancja Open-Meteo (open source, Docker)
OPEN_METEO_FORECAST_URL=
OPEN_METEO_ARCHIVE_URL=
